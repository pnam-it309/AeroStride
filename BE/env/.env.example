# ==============================================================================
# AEROSTRIDE - BACKEND ENVIRONMENT EXAMPLE
# ==============================================================================

SPRING_PROFILES_ACTIVE=mysql

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION
# ------------------------------------------------------------------------------
SERVER_PORT=8080
APP_API_PREFIX=/api/v1
APP_BASE_URL=http://localhost:8080
APP_PUBLIC_URL=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE (MySQL)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=aerostride_db
MYSQL_USER=aerostride_user
MYSQL_PASSWORD=your_user_password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aerostride_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_user_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT (HS512 key >= 64 bytes)
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME__HS512_needs_at_least_64_bytes__replace_with_a_random_string_0123456789
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:8081

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 5. REDIS & CACHE
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
SPRING_CACHE_TYPE=simple

# ------------------------------------------------------------------------------
# 6. PAYMENT (VNPay Sandbox)
# ------------------------------------------------------------------------------
VNP_TMN_CODE=your_vnp_tmn_code
VNP_HASH_SECRET=your_vnp_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_CLIENT_IP=127.0.0.1
ORDER_CLEANUP_THRESHOLD_MS=86400000

# ------------------------------------------------------------------------------
# 7. SHIPPING (Giao Hàng Nhanh - GHN)
# ------------------------------------------------------------------------------
GHN_API_URL=https://online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_ghn_shop_id_here
GHN_FROM_DISTRICT_ID=3440
GHN_FROM_WARD_NAME=Xuan Phuong

# ------------------------------------------------------------------------------
# 8. MAIL SERVICE (SMTP / Resend)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_DEBUG=false
RESEND_API_KEY=
RESEND_FROM=AeroStride <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 9. AI CHATBOT (Ollama / OpenAI)
# ------------------------------------------------------------------------------
SPRING_AI_MODEL_CHAT=none
SPRING_AI_CHAT_CLIENT_ENABLED=false
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:3b
OPENAI_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 10. SYSTEM & LOGGING
# ------------------------------------------------------------------------------
ACTUATOR_ENDPOINTS=health,info,metrics
APP_LOCAL_UPLOAD_DIR=.local-uploads
BATCH_EXCEL_FILE_PATH=
LOGPATTERN_CONSOLE=%green(%d{HH:mm:ss.SSS}) %yellow(%-5level) %red([%thread]) %blue(%logger{255}) - %msg%n
